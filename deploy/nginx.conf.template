worker_processes auto;
pid /runtime/nginx.pid;
# Nginx error logs can contain the full request URI, including credentials.
# Keep request logging disabled; container health checks provide availability.
error_log /dev/null crit;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    sendfile on;
    autoindex off;
    client_body_temp_path /cache/client;
    proxy_temp_path /cache/proxy;
    fastcgi_temp_path /cache/fastcgi;
    uwsgi_temp_path /cache/uwsgi;
    scgi_temp_path /cache/scgi;
    # Container DNS resolves API replacement containers without a runtime rebuild.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    # Empty by default. Only explicitly configured ingress CIDRs may supply IPs.
    ${ENTITLE_REAL_IP_CONFIG}
    map "$uri:$status" $entitle_cache_control {
        default "no-cache";
        ~^/assets/.*:(200|206|304)$ "public, max-age=31536000, immutable";
    }
    server {
        listen 8080;
        server_name _;
        root /releases/current;
        index index.html;
        # The API enforces its configured upload limits while streaming requests.
        client_max_body_size 0;
        # Match production src/app.ts Helmet directives, including defaults.
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; font-src 'self' https: data:; object-src 'none'; script-src 'self' https://js.stripe.com https://*.js.stripe.com; script-src-attr 'none'; style-src 'self'; connect-src 'self' https://api.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com https://checkout.stripe.com https://link.com https://*.link.com; img-src 'self' data: https://*.stripe.com https://*.link.com; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Resource-Policy same-origin always;
        add_header Origin-Agent-Cluster "?1" always;
        add_header Referrer-Policy no-referrer always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-DNS-Prefetch-Control off always;
        add_header X-Download-Options noopen always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Permitted-Cross-Domain-Policies none always;
        add_header X-XSS-Protection 0 always;
        add_header Cache-Control $entitle_cache_control always;

        # A prefix without a URI component preserves the complete API path/query.
        # Override every forwarded-origin header instead of extending user input.
        location ~ ^/api(?:/|$) {
            set $entitle_api "http://${ENTITLE_API_UPSTREAM}";
            proxy_pass $entitle_api;
            proxy_http_version 1.1;
            proxy_request_buffering off;
            proxy_set_header Host ${ENTITLE_PUBLIC_HOST};
            proxy_set_header X-Forwarded-Host ${ENTITLE_PUBLIC_HOST};
            proxy_set_header X-Forwarded-Proto ${ENTITLE_PUBLIC_SCHEME};
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Port "";
            proxy_set_header Connection "";
            proxy_redirect off;
            proxy_intercept_errors off;
            # Avoid inheriting/duplicating static headers. API owns its headers.
            add_header X-Content-Type-Options nosniff always;
        }
        location ^~ /assets/ {
            alias /releases/shared/assets/;
        }
        location = /release-manifest.json { return 404; }
        location ~ (^|/)\. { return 404; }
        location = /healthz { try_files /index.html =503; }
        location = / { try_files /index.html =404; }
        location ~ ^/(seller|docs)/?$ { try_files /index.html =404; }
        location ~ ^/t/[^/]+/?$ { try_files /index.html =404; }
        # Only the application's known client routes get index.html.
        location / { try_files $uri =404; }
    }
}
