{
  "name": "@0xdoublesharp/entitle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.12.0",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/server.ts",
    "cli": "node --env-file-if-exists=.env src/cli.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.ts web/*.test.ts",
    "test:core": "node --test --test-concurrency=1 tests/core.test.ts",
    "test:invariants": "node --test --test-concurrency=1 tests/invariants-*.test.ts",
    "test:fuzz": "FUZZ_RUNS=${FUZZ_RUNS:-500} FUZZ_COMMANDS=${FUZZ_COMMANDS:-100} node --test --test-concurrency=1 tests/invariants-*.test.ts",
    "coverage": "node scripts/coverage.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests web scripts/*.ts",
    "build": "node scripts/build.ts",
    "start": "node --env-file-if-exists=.env scripts/start.ts",
    "maintenance": "node --env-file-if-exists=.env src/maintenance-cli.ts"
  },
  "dependencies": {
    "@0xdoublesharp/adaptive-cache": "0.2.1",
    "@0xdoublesharp/lru-cache-clustered": "2.1.2",
    "@aws-sdk/client-s3": "3.1155.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@stripe/stripe-js": "10.1.0",
    "better-sqlite3": "13.0.3",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "knex": "3.3.0",
    "lru-cache": "11.5.3",
    "mysql2": "3.24.6",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "semver": "7.8.5",
    "stripe": "23.0.0",
    "vue": "3.5.44",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-syntax-typescript": "8.0.3",
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/semver": "7.8.0",
    "@types/yauzl": "3.4.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "license": "SEE LICENSE IN LICENSE"
}
