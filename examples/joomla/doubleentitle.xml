<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="installer" method="upgrade">
  <name>Double Entitle installer transport</name>
  <version>1.0.0</version>
  <license>MIT</license>
  <namespace path="src">DoubleEntitle\Plugin\Installer\DoubleEntitle</namespace>
