NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:3211
# Explicit root mount for the local/standalone app. Hosted mode defaults to /app
# when this override is omitted; match the frontend build's mount.
APP_BASE_PATH=
# Planned production host; apply these values only in the production environment.
# PUBLIC_ORIGIN=https://entitle.doublesharp.com
# PUBLIC_ORIGIN is shared by the application and HTTPS proxy.
# Standalone Compose web runtime: use the host from PUBLIC_ORIGIN.
# ENTITLE_PUBLIC_HOST=licenses.example.com
# ENTITLE_WEB_RELEASE_DIR=/srv/entitle/frontend
PORT=3211
# Generate each secret independently. Keep APP_SECRET backed up to decrypt outbox credentials.
APP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
OPERATOR_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATA_DIR=/Volumes/Scratch/entitle/data/local
BUILD_DIR=/Volumes/Scratch/entitle/build/main
# DATABASE_URL=postgresql://user:password@localhost:5432/entitle
# DATABASE_URL=mysql://user:password@localhost:3306/entitle
# DATABASE_URL=sqlite:/srv/entitle/entitle.sqlite
# WORK_DIR=/srv/entitle/work
# WEB_DIR=/app/dist/web
LOCAL_BILLING=true
# Self-hosted standalone: one publisher, primary workspace, direct Stripe.
# Set the owner email before signing in at /seller. No Connect/platform price needed.
# Hosted platform: explicitly use DEPLOYMENT_MODE=hosted, configure Connect and
# PLATFORM_STRIPE_PRICE_ID below, and review docs/deployment.md for license rights.
# Existing multitenant databases must explicitly keep DEPLOYMENT_MODE=hosted.
DEPLOYMENT_MODE=standalone
STANDALONE_OWNER_EMAIL=
# Hosted only: defaults to 1%, in addition to the SaaS subscription and Stripe fees.
# HOSTED_APPLICATION_FEE_PERCENT=1
# For a production complimentary pilot, LOCAL_BILLING=false and leave all primary
# Stripe/Connect/platform price values empty. Configure the full set for payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Merchant webhook secret in standalone; platform webhook secret in hosted mode.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_LIVE_MODE=false
PLATFORM_STRIPE_PRICE_ID=
# Private S3-compatible bucket. Load the generated integration.env for the local fixture.
S3_BUCKET=entitle-local
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# HTTP is development-only and rejected in production.
S3_ALLOW_HTTP=false
MAX_UPLOAD_MIB=25
TRANSFER_MEMORY_MIB=256
MAX_TENANTS_PER_SELLER=3
TRIAL_DAYS=14
GRACE_DAYS=7
TRIAL_STORAGE_MIB=100
PAID_MAX_PRODUCTS=20
PAID_STORAGE_MIB=1024
DAILY_EMAIL_LIMIT=1000
PLATFORM_DAILY_EMAIL_LIMIT=1000
MAX_SELLER_SIGNUPS_PER_HOUR=500
# Scoped seller automation, never shipped in browser code or plugin ZIPs.
TENANT_SLUG=
TENANT_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=licenses@example.test
# Disabled by default. Exact host or dot-delimited suffix, e.g. staging.example.com
DEVELOPMENT_HOST_SUFFIXES=
# Set to the exact private reverse-proxy IP/subnet, never blanket true.
TRUST_PROXY=
# Optional internal URL for authenticated operator CLI behind the proxy.
OPERATOR_ORIGIN=http://127.0.0.1:3211

# Optional adaptive-cache backend. Blank uses bounded in-memory caching, with no Redis.
CACHE_REDIS_URL=
# Examples: redis://cache:6379/0 or rediss://user:password@cache.example:6380/0
# Keep this URL private. Redis is disposable cache state, never entitlement authority.
CACHE_MEMORY_MIB=8
# Use a distinct namespace for separate deployments sharing a Redis server.
CACHE_NAMESPACE=entitle

# Hosted monthly Pro. Must be distinct from the Starter platform price.
# Omit entirely until configured; a blank optional value is not a valid price ID.
# PLATFORM_PRO_STRIPE_PRICE_ID=price_REPLACE
# Optional operator-verified direct merchant identity for standalone encrypted export.
# STANDALONE_STRIPE_ACCOUNT_ID=acct_REPLACE
# Separate complete test-mode credentials, never live keys, for publisher Stripe sandboxes.
# STRIPE_TEST_SECRET_KEY=sk_test_REPLACE
# STRIPE_TEST_PUBLISHABLE_KEY=pk_test_REPLACE
# STRIPE_TEST_WEBHOOK_SECRET=whsec_REPLACE
# Optional additional webhook restriction. Exact public DNS names, comma separated.
# OUTBOUND_WEBHOOK_HOSTS=hooks.example.com,automation.example.com

# Native packages use file spools; WordPress retains MAX_UPLOAD_MIB above.
MAX_NATIVE_UPLOAD_MIB=100
# Incoming publication needs two disk copies, separate from the verified-download cache.
NATIVE_SPOOL_MIB=4096
NATIVE_UPLOAD_TIMEOUT_MS=120000
ARTIFACT_CACHE_MIB=4096
ARTIFACT_CACHE_INFLIGHT_MIB=2048
ARTIFACT_CACHE_TTL_MS=300000
# Transfer inactivity window; total native budgets scale with object size.
ARTIFACT_TRANSFER_TIMEOUT_MS=120000
MIN_DISK_FREE_MIB=64

# Shared encrypted export admission: one active bundle per tenant.
# Count includes creations in progress; disk reservation is shared across all bundles.
EXPORT_MAX_EXPORTS=4
EXPORT_MAX_GIB=10
