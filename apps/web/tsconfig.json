{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../..",
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "vue": ["./node_modules/vue"],
      "@stripe/stripe-js": ["./node_modules/@stripe/stripe-js"],
      "@stripe/stripe-js/*": ["./node_modules/@stripe/stripe-js/*"]
    }
  },
  "include": ["../../web/**/*.ts", "../../packages/shared/**/*.ts"],
  "exclude": ["../../node_modules"]
}
